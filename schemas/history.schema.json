{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/superbigcup325/moonperf-lab/main/schemas/history.schema.json",
  "title": "MoonPerf Lab result history index",
  "description": "A results/<workload>/index.json, generated by `mpf history` from the committed artifacts. It is derived data: it never measures, never fills a missing number, and the artifacts stay the source of truth.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "workload",
    "entries"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "workload": {
      "$ref": "#/$defs/identifier"
    },
    "entries": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/entry"
      }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$",
      "maxLength": 64
    },
    "artifact_name": {
      "type": "string",
      "pattern": "^[0-9]{8}T[0-9]{6}Z-[0-9a-f]{12}\\.json$",
      "description": "Artifact file name inside the workload results directory."
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "point": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "language",
        "reference",
        "median_ns",
        "cv",
        "samples",
        "correctness"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "language": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "reference": {
          "type": "boolean"
        },
        "median_ns": {
          "type": [
            "number",
            "null"
          ],
          "exclusiveMinimum": 0,
          "description": "Null when the implementation carried no samples (a failed or excluded run); never zero as a stand-in."
        },
        "cv": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "samples": {
          "type": "integer",
          "minimum": 0
        },
        "correctness": {
          "type": "boolean"
        }
      }
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact",
        "id",
        "started_at",
        "workload_version",
        "tier",
        "verdict",
        "harness_version",
        "manifest_sha256",
        "source",
        "host",
        "dataset",
        "implementations"
      ],
      "properties": {
        "artifact": {
          "$ref": "#/$defs/artifact_name"
        },
        "id": {
          "type": "string",
          "pattern": "^[0-9]{8}T[0-9]{6}Z-[0-9a-f]{12}$"
        },
        "started_at": {
          "type": "string",
          "format": "date-time"
        },
        "workload_version": {
          "type": "integer",
          "minimum": 1
        },
        "tier": {
          "enum": [
            "micro",
            "component",
            "end-to-end"
          ]
        },
        "verdict": {
          "enum": [
            "ok",
            "unstable",
            "invalid"
          ]
        },
        "harness_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32
        },
        "manifest_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "commit",
            "branch",
            "dirty"
          ],
          "properties": {
            "commit": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            },
            "branch": {
              "type": "string",
              "maxLength": 255
            },
            "dirty": {
              "type": "boolean"
            }
          }
        },
        "host": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "profile"
          ],
          "properties": {
            "profile": {
              "type": "string",
              "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
              "maxLength": 96,
              "description": "Coarse identity of the measurement conditions (OS, arch, CPU model, logical CPUs, governor). Runs are comparable only within one profile."
            }
          }
        },
        "dataset": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "generator",
            "count",
            "seed",
            "sha256"
          ],
          "properties": {
            "generator": {
              "$ref": "#/$defs/identifier"
            },
            "count": {
              "type": "integer",
              "minimum": 1
            },
            "seed": {
              "type": "integer",
              "minimum": 0
            },
            "sha256": {
              "$ref": "#/$defs/sha256"
            }
          }
        },
        "implementations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/point"
          }
        }
      }
    }
  }
}
