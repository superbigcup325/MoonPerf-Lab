# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/
dist/

# Generated datasets. They are rebuilt from (generator, count, seed, params)
# recorded in the workload manifest; the bytes never enter version control.
.data/

# Scratch results; curated artifacts live under results/ and are committed.
# Use results/tmp/ for scratch runs. A results/tmp-* directory is a scratch
# run too, not a committed artifact.
results/tmp/
results/tmp-*/

# Build outputs of the implementations under test
target/
_build/
.mooncakes/
.moonagent/
*.o
*.obj

# OS / editor noise
.DS_Store
Thumbs.db
*.swp

# Fixture runtime marker (created by the timeout fixture)
tests/fixtures/**/calls
